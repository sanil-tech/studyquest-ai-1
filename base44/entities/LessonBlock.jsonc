{
  "name": "LessonBlock",
  "type": "object",
  "description": "Flexible, ordered content block belonging to a LessonVersion featuring DSKP pedagogical metadata",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique block ID"
    },
    "lesson_version_id": {
      "type": "string",
      "description": "Foreign key linking to LessonVersion entity (optional for standalone assets)"
    },
    "topic_id": {
      "type": "string",
      "description": "ID of the parent Topic (for standalone assets not tied to a lesson version)"
    },
    "subtopic_id": {
      "type": "string",
      "description": "ID of the parent Subtopic (for standalone assets)"
    },
    "learning_standard_id": {
      "type": "string",
      "description": "Optional DSKP SP code reference (e.g., SP 1.1.1)"
    },
    "sp_code": {
      "type": "string",
      "description": "DSKP Standard Pembelajaran code"
    },
    "pedagogical_phase": {
      "type": "string",
      "enum": [
        "INDUCTION",
        "CONCEPT",
        "WORKED_EXAMPLE",
        "PBD_ASSESSMENT",
        "REFLECTION"
      ],
      "default": "CONCEPT",
      "description": "Malaysian formal 5-phase lesson structure index"
    },
    "cognitive_level": {
      "type": "string",
      "enum": [
        "remember",
        "understand",
        "apply",
        "analyze",
        "evaluate",
        "create"
      ],
      "default": "understand",
      "description": "Bloom's taxonomy cognitive level"
    },
    "block_type": {
      "type": "string",
      "enum": [
        "TEXT_MARKDOWN",
        "VIDEO_EMBED",
        "MIND_MAP",
        "AUDIO_TTS",
        "FLASHCARD_DECK",
        "INTERACTIVE_GAME"
      ],
      "description": "Determines how the block is rendered in the UI"
    },
    "title": {
      "type": "string",
      "description": "Optional section header title"
    },
    "order_number": {
      "type": "number",
      "description": "Sequential sorting index (0, 1, 2...)"
    },
    "payload": {
      "type": "object",
      "description": "Type-specific structured JSON content"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "under_review",
        "approved",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "created_source": {
      "type": "string",
      "enum": [
        "manual",
        "ai_generated"
      ],
      "default": "manual"
    },
    "approved_by": {
      "type": "string",
      "description": "User ID of admin who approved this block"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this block was approved"
    }
  },
  "required": [
    "block_type",
    "order_number",
    "payload"
  ]
}