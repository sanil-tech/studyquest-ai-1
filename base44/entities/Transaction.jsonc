{
  "name": "Transaction",
  "type": "object",
  "description": "Record of XP and Coin rewards earned or spent by a student",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Student identifier"
    },
    "type": {
      "type": "string",
      "enum": ["earn", "spend"],
      "description": "Transaction type: earn or spend"
    },
    "amount_xp": {
      "type": "number",
      "default": 0,
      "description": "XP amount added or subtracted"
    },
    "amount_coins": {
      "type": "number",
      "default": 0,
      "description": "Coins amount added or subtracted"
    },
    "reason": {
      "type": "string",
      "description": "Reason for transaction (e.g., Quiz completed, Avatar item purchase)"
    },
    "reference_id": {
      "type": "string",
      "description": "Optional reference ID (quiz_attempt_id, item_id, etc.)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "student_id",
    "type",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.student_id": {
            "$in": "{{user.data.linked_student_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}